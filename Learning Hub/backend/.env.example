PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
DEMO_MODE=true

# ---- Web3 provider (leave CHAIN_RPC_URL empty for ledger-only mode)
# Local:   run `npm run chain` from the repo root, then use http://127.0.0.1:8545
CHAIN_RPC_URL=http://127.0.0.1:8545
# Leave empty to auto-deploy CertificateRegistry on first start
CONTRACT_ADDRESS=
AUTO_DEPLOY_CONTRACT=true
# Testnets: set a FUNDED key here (it signs certificates and pays gas)
ISSUER_PRIVATE_KEY=
EXPLORER_URL=
# e.g. Sepolia: CHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com  EXPLORER_URL=https://sepolia.etherscan.io

# ---- AI Learning Assistant: Google Gemini (get a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Payments: Stripe (test keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:4000/api/payments/webhook` (optional, recommended)
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
